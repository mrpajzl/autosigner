// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  nickname      String   @unique
  passwordHash  String?  // Optional for Discord OAuth users
  role          String   @default("MANAGER")
  status        String   @default("APPROVED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Discord OAuth fields
  authProvider    String  @default("local") // "local" or "discord"
  discordId       String? @unique // Discord user ID from OAuth
  discordUsername String? // Discord username (e.g., "johndoe" or "johndoe#1234")
  discordAvatar   String? // Discord avatar URL

  managerProfile ManagerProfile?
  apps           App[]
  sessions       Session[]
  certificates   Certificate[]
  provisioningProfiles ProvisioningProfile[]
  signedVersions SignedVersion[]
  appleDeveloperCredentials AppleDeveloperCredentials?
  registeredUsers RegisteredUser[] // For moderators managing user databases
  linkedRegistrations RegisteredUser[] @relation("DiscordUserLink") // For Discord users linked to registrations
}

model ManagerProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  displayName     String
  companyName     String?
  certificatePem  String? // PEM-encoded certificate (encrypted at rest)
  privateKeyPem   String? // PEM-encoded private key (encrypted at rest)
  // Encrypted JSON from encrypt() containing iv+data for p12 password
  p12PasswordEnc  String?
  // Keep last uploaded provisioning profiles per platform (encrypted at rest)
  mobileprovisionIos  Bytes?
  mobileprovisionTvos Bytes?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([token])
}

model App {
  id              String   @id @default(cuid())
  ownerId         String
  platform        String   @default("IOS") // IOS | TVOS
  name            String
  bundleId        String
  version         String
  buildNumber     String?
  showBuildNumber Boolean  @default(false) // Show build number on homepage for all users
  /// When true, this app is only shown to logged-in users (hidden from public listings)
  loggedInOnly    Boolean  @default(false)
  ipaFileName     String?
  originalIpaPath String
  signedIpaPath   String?
  manifestPath    String?
  iconPath        String?
  sizeBytes       Int?
  uploadedAt      DateTime @default(now())
  signedAt        DateTime?
  status          String   @default("PENDING") // PENDING | SIGNING | SIGNED | FAILED

  owner User @relation(fields: [ownerId], references: [id])
  signedVersions SignedVersion[]

  @@index([ownerId])
  @@index([bundleId])
}

// Represents a signed version of an app by a specific moderator
// Each moderator can sign any uploaded app with their own credentials
model SignedVersion {
  id            String    @id @default(cuid())
  appId         String
  signerId      String
  signedIpaPath String?
  manifestPath  String?
  status        String    @default("PENDING") // PENDING | SIGNING | SIGNED | FAILED
  signedAt      DateTime?
  createdAt     DateTime  @default(now())

  app    App  @relation(fields: [appId], references: [id], onDelete: Cascade)
  signer User @relation(fields: [signerId], references: [id])

  @@unique([appId, signerId])
  @@index([appId])
  @@index([signerId])
}

// Note: SQLite connector doesn't support enums; using string fields.

model Certificate {
  id             String   @id @default(cuid())
  userId         String
  displayName    String?
  p12Data        Bytes
  // Encrypted JSON from encrypt() containing iv+data
  p12PasswordEnc String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  active         Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
  @@index([userId, active])
}

model ProvisioningProfile {
  id        String   @id @default(cuid())
  userId    String
  platform  String   // IOS | TVOS
  name      String?
  uuid      String?
  teamId    String?
  expiresAt DateTime?
  data      Bytes     // raw .mobileprovision data
  createdAt DateTime @default(now())
  active    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
  @@index([userId, platform, active])
}

// Apple Developer API credentials for each moderator (optional)
// Allows direct integration with App Store Connect API for managing
// devices (UDIDs) and provisioning profiles
model AppleDeveloperCredentials {
  id            String   @id @default(cuid())
  userId        String   @unique
  keyId         String   // API Key ID from App Store Connect
  issuerId      String   // Issuer ID from App Store Connect
  privateKeyEnc String   // Encrypted .p8 private key content
  teamName      String?  // Optional display name for the team
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// A registered user (typically Discord member who wants apps signed)
// Each moderator maintains their own user database
model RegisteredUser {
  id              String   @id @default(cuid())
  ownerId         String   // The moderator who owns this user database
  discordName     String   // Discord nickname (e.g., "john_doe" or "John#1234")
  discordId       String?  // Discord ID from OAuth (for automatic linking)
  notes           String?  // Optional notes about the user
  paidForNextYear Boolean  @default(false) // Track if user has paid for the next year's registration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Optional link to actual Discord-authenticated user
  linkedUserId    String?
  linkedUser      User?    @relation("DiscordUserLink", fields: [linkedUserId], references: [id], onDelete: SetNull)

  owner   User         @relation(fields: [ownerId], references: [id])
  devices UserDevice[]

  @@unique([ownerId, discordName]) // Unique per moderator
  @@index([ownerId])
  @@index([discordId]) // For quick lookup when Discord user logs in
  @@index([linkedUserId])
}

// A device belonging to a registered user
model UserDevice {
  id               String   @id @default(cuid())
  registeredUserId String
  udid             String   // Device UDID
  name             String   // Device name (e.g., "John - iPhone 1")
  deviceNumber     Int      // Sequential number per device type (1, 2, 3, etc.)
  platform         String   @default("IOS") // IOS | MAC_OS | APPLE_TV
  appleDeviceId    String?  // Apple Developer Portal device ID (for syncing names)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  registeredUser RegisteredUser @relation(fields: [registeredUserId], references: [id], onDelete: Cascade)

  @@unique([registeredUserId, udid]) // One device per user
  @@unique([registeredUserId, platform, deviceNumber]) // Unique device number per user per platform
  @@index([registeredUserId])
  @@index([udid]) // For quick lookup when checking Apple registration
}

