# NOTE: This Dockerfile is for development/testing on non-macOS systems.
# For production signing, run directly on macOS (M4 Mac) where native
# codesign is available.
#
# This container can run the web UI and API, but signing will fail
# because macOS codesign is not available in Docker.

FROM node:22-bookworm-slim

# System deps for build tools
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    openssl unzip zip ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# App dir
WORKDIR /app

# Install node deps with caching
COPY package.json package-lock.json ./
RUN npm ci

# Copy app source
COPY . .

# Generate Prisma client
RUN npx prisma generate

# Expose dev server
EXPOSE 3000

# Note: Signing won't work in Docker - run on macOS for full functionality
CMD ["npm", "run", "dev:local"]
